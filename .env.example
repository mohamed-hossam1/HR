# Database (Supabase PostgreSQL / Managed Postgres)
# Pooled connection URL:
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Better Auth Configuration
BETTER_AUTH_SECRET=generate-a-secure-random-32-byte-hex-secret-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security Keys
# 32+ character secret pepper for hashing private tracking codes
TRACKING_SECRET_PEPPER=change-this-to-a-high-entropy-secure-random-pepper-for-tracking
# 32-byte (64 hex characters) encryption key for AES-256-GCM encryption of sensitive data (e.g. National IDs)
SENSITIVE_DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Backblaze B2 (S3-Compatible Cloud Storage)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=employee-services-portal-docs
B2_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key_secret
# Soft storage warning ceiling (in Megabytes). Backblaze B2 offers 10 GB free.
B2_SOFT_STORAGE_LIMIT_MB=8000

# Initial Admin Credentials (used only by npm run seed:admin)
ADMIN_INITIAL_EMAIL=admin@portal.local
ADMIN_INITIAL_PASSWORD=AdminStrongPass2026!
